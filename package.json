{
  "name": "hkustech-tree",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-only HKUST course prerequisite tree",
  "scripts": {
    "build": "node tools/build-catalog.mjs --if-missing && node tools/build-pages.mjs",
    "build:catalog": "node tools/build-catalog.mjs",
    "build:major": "node tools/build-major.mjs",
    "build:pages": "node tools/build-pages.mjs",
    "import:major": "node tools/import-major.mjs",
    "update:data": "node tools/update-data.mjs",
    "check:data": "node tools/update-data.mjs --check --offline",
    "serve": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "node-html-parser": "^6.1.13"
  }
}
